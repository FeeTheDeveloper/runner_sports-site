# The Odds API — https://the-odds-api.com/ (account dashboard shows your key)
ODDS_API_KEY=

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only, never expose to the client. Copy from the same API settings page.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked against the Authorization: Bearer header on
# /api/cron/sync-odds. Generate any random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Prediction-market data is read-only in this release. Public Kalshi and
# Polymarket market discovery does not require trading credentials.
# Kalshi credentials are reserved for the authenticated realtime worker.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_BASE64=
KALSHI_ENV=production

# ESPN endpoints are unofficial/undocumented and require no API key. The ESPN
# cron (app/api/cron/sync-espn) calls them with defensive caching, timeouts,
# and soft-fail handling; see lib/providers/espnApi.ts for the exact posture.

# Clerk — copy from the Clerk application dashboard. The secret key is
# server-only. These activate /sign-up, /sign-in, /account, and /billing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/picks
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/picks

# Stripe — prefer a restricted server key after validating its permissions.
# Create one Product per paid access level and paste each recurring Price ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RUNNER_PRO=
STRIPE_PRICE_RUNNER_COMMAND=

# Canonical deployment origin used for Stripe redirects and MCP result URLs.
NEXT_PUBLIC_APP_URL=https://werunsportsandanalytics.com

# Runner Sports Demon — local/approved intelligence API consumed by the site
# server layer during local development. Do not expose a private LAN endpoint
# to browser code or production clients. Production should use an approved
# reachable service/data layer.
RUNNER_DEMON_API_URL=http://localhost:8787

# Optional local Google Drive Desktop bridge. Actual machine paths belong in
# .env.local only. These folders exchange company research/reports and are not
# the latency-sensitive live-data transport.
RUNNER_SITE_DRIVE_IMPORT_DIR=
RUNNER_SITE_DRIVE_EXPORT_DIR=
